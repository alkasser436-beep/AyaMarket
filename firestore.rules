rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 250)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
             data.favoriteIds is list && data.favoriteIds.size() <= 50 &&
             (data.favoriteIds.size() == 0 || data.favoriteIds[0] is string) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCartEntry(data, userId, productId) {
      return data.userId is string && data.userId == userId &&
             data.productId is string && data.productId == productId &&
             data.productId.size() >= 1 && data.productId.size() <= 64 &&
             data.quantity is int && data.quantity >= 1 && data.quantity <= 99 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidOrder(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 24 &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
             data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
             data.deliveryAddress is string && data.deliveryAddress.size() >= 5 && data.deliveryAddress.size() <= 250 &&
             (!('deliveryNotes' in data) || (data.deliveryNotes is string && data.deliveryNotes.size() <= 300)) &&
             data.paymentMethod is string && data.paymentMethod in ['cash_on_delivery', 'card_on_delivery'] &&
             data.status is string && data.status in ['pending', 'preparing', 'on_the_way', 'delivered', 'cancelled'] &&
             data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 1000 &&
             data.items is list && data.items.size() >= 1 && data.items.size() <= 40 &&
             data.items[0] is map &&
             data.totalItems is int && data.totalItems >= 1 && data.totalItems <= 200 &&
             data.subtotal is number && data.subtotal >= 0 &&
             data.deliveryFee is number && data.deliveryFee >= 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'favoriteIds', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'phone', 'address', 'notes', 'favoriteIds', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'address', 'notes', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['favoriteIds', 'updatedAt'])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /cart/{productId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(productId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(productId) &&
                         incoming().keys().hasAll(['userId', 'productId', 'quantity', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'productId', 'quantity', 'createdAt', 'updatedAt']) &&
                         isValidCartEntry(incoming(), userId, productId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(productId) &&
                         isValidCartEntry(incoming(), userId, productId) &&
                         incoming().userId == existing().userId &&
                         incoming().productId == existing().productId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(productId);
      }

      match /orders/{orderId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(orderId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(orderId) &&
                         incoming().keys().hasAll([
                           'userId', 'orderNumber', 'customerName', 'phone', 'deliveryAddress',
                           'paymentMethod', 'status', 'itemsSummary', 'items', 'totalItems',
                           'subtotal', 'deliveryFee', 'totalAmount', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'orderNumber', 'customerName', 'phone', 'deliveryAddress',
                           'deliveryNotes', 'paymentMethod', 'status', 'itemsSummary', 'items',
                           'totalItems', 'subtotal', 'deliveryFee', 'totalAmount', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().status == 'pending' &&
                         isValidOrder(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(orderId) &&
                         isValidOrder(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         !(existing().status in ['delivered', 'cancelled']) &&
                         (
                           existing().status == 'pending' &&
                           incoming().status == 'cancelled' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                         );

        allow delete: if false;
      }
    }
  }
}
